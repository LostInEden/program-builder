# Copy to .env.local for local testing (never commit .env.local).
# On Vercel, set these under Project -> Settings -> Environment Variables.

# Server-only. The coach's OpenAI API key (platform.openai.com -> API keys).
OPENAI_API_KEY=

# Turns the model on in the browser build. "local" (or unset) = rules engine only.
NEXT_PUBLIC_AI_PROVIDER=remote

# Optional. Defaults: gpt-6-sol, low.
# OPENAI_MODEL=gpt-6-sol
# OPENAI_REASONING_EFFORT=low
